# OpenVPN Wizard v2 - client profile
# Profile: {{ profile_name }}
# Endpoint: {{ config.remote_host }}:{{ config.public_port }}/{{ config.vpn_proto }}
# Authentication: {{ "certificate + username/password" if config.auth_mode == "userpass" else "certificate only" }}
# Access: {{ "full tunnel (all traffic through VPN)" if config.access_mode == "free" else "locked (VPN network only)" }}
# Generated: {{ generated_at }}
#
# Import this single file into OpenVPN Connect (Android/iOS), OpenVPN GUI
# (Windows), Tunnelblick (macOS) or the openvpn command line client.

client
dev tun
proto {{ "tcp-client" if config.vpn_proto == "tcp" else "udp" }}
remote {{ config.remote_host }} {{ config.public_port }}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name server name
data-ciphers AES-256-GCM:CHACHA20-POLY1305:AES-128-GCM
data-ciphers-fallback AES-256-GCM
auth SHA256
cipher AES-256-GCM
tls-version-min 1.2
tls-ciphersuites TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
tls-cipher TLS-ECDHE-ECDSA-WITH-AES-256-GCM-SHA384:TLS-ECDHE-RSA-WITH-AES-256-GCM-SHA384:TLS-ECDHE-ECDSA-WITH-CHACHA20-POLY1305-SHA256:TLS-ECDHE-RSA-WITH-CHACHA20-POLY1305-SHA256
{% if config.access_mode == "locked" %}
# Locked profile: never accept server routes or DNS, only reach the VPN subnet.
route-nopull
route {{ config.vpn_subnet }} {{ config.vpn_netmask }}
pull-filter ignore "redirect-gateway"
pull-filter ignore "dhcp-option"
{% endif %}
{% if config.auth_mode == "userpass" %}
auth-user-pass
{% endif %}
{% if config.vpn_proto == "tcp" %}
tcp-nodelay
mssfix 1360
{% else %}
explicit-exit-notify 2
mssfix 1420
{% endif %}
sndbuf 0
rcvbuf 0
reneg-sec 3600
verb 3
mute 20

<ca>
{{ ca_crt }}
</ca>

<cert>
{{ client_crt }}
</cert>

<key>
{{ client_key }}
</key>

<tls-crypt>
{{ ta_key }}
</tls-crypt>
