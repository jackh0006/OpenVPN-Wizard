client
dev tun
proto {{ config.vpn_proto }}
remote {{ config.remote_host }} {{ config.public_port }}
nobind
{% if config.auth_mode == "userpass" %}
auth-user-pass
{% endif %}

# Maximum security crypto (matches server TLS 1.3 only)
cipher {{ config.cipher }}
auth {{ config.auth_digest }}
data-ciphers {{ config.data_ciphers }}
tls-version-min {{ config.tls_min }}
{% if config.tls_max %}tls-version-max {{ config.tls_max }}
{% endif %}remote-cert-tls server
tls-client
tls-ciphersuites {{ config.tls_ciphersuites }}

{% if config.access_mode == "locked" %}
# Locked profile: never accept server routes or DNS, only reach the VPN subnet.
route-nopull
route {{ config.vpn_subnet }} {{ config.vpn_netmask }}
pull-filter ignore "redirect-gateway"
pull-filter ignore "dhcp-option"
{% endif %}
# TCP optimizations for large transfers
sndbuf {{ config.sndbuf }}
rcvbuf {{ config.rcvbuf }}

# Stealth / DPI resistance - look like normal HTTPS
{% if config.vpn_proto == "tcp" %}
tcp-nodelay
explicit-exit-notify 0
{% else %}
explicit-exit-notify 2
{% endif %}
reneg-sec 3600
mssfix {{ config.mssfix }}
verb 3

# TLS-Crypt v1 (matches server)
<tls-crypt>
{{ ta_key }}
</tls-crypt>

<ca>
{{ ca_crt }}
</ca>

<cert>
{{ client_crt }}
</cert>

<key>
{{ client_key }}
</key>
